<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Заголовок экрана -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Мои задачи:"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Первая задача-заглушка -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/task_1"
        android:textSize="18sp"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:background="#EEEEEE" />

    <!-- Вторая задача-заглушка -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/task_2"
        android:textSize="18sp"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:background="#EEEEEE" />

    <!-- Третья задача-заглушка -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/task_3"
        android:textSize="18sp"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:background="#EEEEEE" />

    <!-- Четвертая задача-заглушка -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/task_4"
        android:textSize="18sp"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:background="#EEEEEE" />

</LinearLayout>